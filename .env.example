# All optional — the app builds and runs with none of these set.
# Copy to .env.local and fill in the ones you want.

# PostHog analytics (client-side). Leave unset to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Email capture via Resend (server-side only). Leave unset to disable the
# /api/subscribe endpoint. Use a full-access key (sending-only keys can't
# manage contacts).
RESEND_API_KEY=

# Jarvis personal assistant (server-only; never use NEXT_PUBLIC_ prefixes)
OPENAI_API_KEY=
# At least 16 characters; required before any agent route can be used.
JARVIS_ACCESS_PASSWORD=
# Optional override; defaults to the current managed Agents quickstart model.
JARVIS_AGENT_MODEL=gpt-6-astra
